# CoinWake Environment Variables
# Copy to .env.local (frontend) or .env (backend) and fill in values

# ==========================================
# FRONTEND (Vite) - .env.local
# ==========================================
# Production API URL (set after backend deploy)
VITE_API_URL=https://coinwake-api.onrender.com/api

# ==========================================
# BACKEND (Express) - .env
# ==========================================
NODE_ENV=production
PORT=10000

# MongoDB Atlas (REQUIRED for production)
# Get from: MongoDB Atlas → Clusters → Connect → Drivers → Copy connection string
# Replace <db_password> with actual password
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/coinwake?retryWrites=true&w=majority

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Crypto Provider
CRYPTO_PROVIDER=coingecko
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=  # Optional: CoinGecko Pro key for higher rate limits

# Price Service
PRICE_POLL_INTERVAL_MS=20000

# Cache TTL (seconds)
CACHE_TTL_PRICE=20
CACHE_TTL_MARKET=60
CACHE_TTL_METADATA=86400
CACHE_TTL_CHART=900

# Wallet Provider (live for production)
WALLET_PROVIDER=live
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
EVM_RPC_URL=https://eth.llamarpc.com

# Web Push (VAPID keys - generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@coinwake.app

# CORS Origins (comma-separated, no spaces)
CORS_ORIGIN=https://coinwake.app,https://coinwake-web.vercel.app,capacitor://localhost,http://localhost:8080

# Redis (optional - for distributed caching)
REDIS_URL=