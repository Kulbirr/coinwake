# ─── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (the Vite dev server by default).
CORS_ORIGIN=http://localhost:8080,http://localhost:5173

# ─── Datastores ───────────────────────────────────────────────────────────────
# MongoDB Atlas — the free M0 tier is plenty. Atlas → Connect → Drivers → Node.js,
# then paste the string here and append the database name:
#
#   MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/coinwake?retryWrites=true&w=majority
#
# Two things trip up every first setup:
#   1. Network Access → Add IP Address → Add Current IP Address. Without it the
#      connection just times out, with no hint that the allowlist is the reason.
#   2. Percent-encode @ : / ? # % in the password — @ becomes %40.
# Leave this empty and the server boots an in-memory MongoDB instead (dev only,
# data is lost on restart). Either way the database is named `coinwake`.
MONGODB_URI=
# Leave REDIS_URL empty to fall back to an in-process TTL cache (single instance
# only — set a real Redis URL before running more than one server process).
REDIS_URL=

# ─── Auth ─────────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# Optional — enables POST /api/auth/google (verified against Google's tokeninfo).
GOOGLE_CLIENT_ID=

# ─── Market data provider ─────────────────────────────────────────────────────
# mock | coingecko
CRYPTO_PROVIDER=mock
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Free "demo" key from https://www.coingecko.com/en/developers/dashboard
# Never put this in the frontend — the browser talks to this server, not CoinGecko.
COINGECKO_API_KEY=

# How often the price service refreshes the tracked-coin snapshot.
# CoinGecko's free tier allows ~30 calls/min; 20s keeps us far under that.
PRICE_POLL_INTERVAL_MS=20000

# Cache TTLs in seconds (spec: metadata long, price short, history longer).
CACHE_TTL_PRICE=20
CACHE_TTL_MARKET=60
CACHE_TTL_METADATA=86400
CACHE_TTL_CHART=900

# ─── Wallets (read-only) ──────────────────────────────────────────────────────
# mock | live
WALLET_PROVIDER=mock
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
EVM_RPC_URL=https://eth.llamarpc.com

# ─── Web Push ─────────────────────────────────────────────────────────────────
# Generate a keypair with: npx web-push generate-vapid-keys
# The public key is safe to ship to the browser; the private key is not.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@coinwake.app
