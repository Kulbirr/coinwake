{
  "name": "coinwake-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CoinWake backend — REST API, server-side price service, alert engine and notification service.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
