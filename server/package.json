    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "bs58": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "ethers": "^6.13.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "tweetnacl": "^1.0.3",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/mongodb": "^4.0.7",
    "@types/node": "^22.16.5",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.5.13",
    "mongodb-memory-server": "^10.1.4",
